# TEMPLATE ONLY — this file is published on GitHub. NEVER put real keys here.
# Copy it to .env.local (git-ignored) and fill in the real values there.

# ── Supabase (Project Settings → API Keys) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# "Publishable" key (sb_publishable_…) — safe in the browser, RLS applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret" key (sb_secret_…) — SERVER ONLY, bypasses RLS. Paste it yourself.
SUPABASE_SECRET_KEY=

# ── App ───────────────────────────────────────────────────────────────────
# Public URL of the app (your domain in production). Used for auth emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Phase 2 integrations (leave empty for now) ────────────────────────────
# Roblox Open Cloud key(s) with universe.analytics:read on your experiences.
# One key per Roblox group/account if your games are spread across several;
# each game automatically uses the key that can read it (_2 … _5 are optional).
ROBLOX_OPEN_CLOUD_API_KEY=
ROBLOX_OPEN_CLOUD_API_KEY_2=
# Claude API key for the AI assistant.
ANTHROPIC_API_KEY=
